# For local setup, run `npm run setup:telegram` to enter this token without echoing it.
# On Railway, add TELEGRAM_BOT_TOKEN as a service variable and attach a public HTTPS domain.
# RAILWAY_PUBLIC_DOMAIN automatically enables webhook delivery; APP_URL can override it.
# Without a public HTTPS URL, local development uses long polling.
# Never commit the real token. Rotate it in @BotFather if it has been exposed.
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
APP_URL=
# Optional stable webhook secret. If omitted, one is generated for each server start.
TELEGRAM_WEBHOOK_SECRET=

# Cheapest Railway setup uses ephemeral storage; bot-added links reset after redeploys.
# Add a persistent volume only if retaining those links is worth its added cost.
BOT_DATA_DIR=./data

# PORT: The server port (defaults to 3000)
PORT=3000

# NODE_ENV: production or development
NODE_ENV=production
