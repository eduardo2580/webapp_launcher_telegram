# Telegram bot token from @BotFather. Keep it private.
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather

# Optional server-wide Gemini key. Disabled for users unless explicitly enabled below.
# Users can also add their own key in a private Telegram chat with /setkey.
GEMINI_API_KEY=replace-with-gemini-api-key
ALLOW_SHARED_GEMINI_KEY=false

# Model and system instructions for Gemini.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SYSTEM_INSTRUCTION=You are a helpful and concise assistant.

# JSON file for chat-specific app lists and language preferences.
# This file never contains user Gemini API keys.
DATA_FILE=bot_data.json

# Railway public HTTPS domain enables Telegram webhooks automatically.
# Set APP_URL only if using a custom public HTTPS domain.
APP_URL=
# Optional stable webhook secret; a secure value is generated if empty.
TELEGRAM_WEBHOOK_SECRET=

# HTTP health-check/webhook port (Railway sets PORT automatically).
PORT=3000
