# For local setup, run `npm run setup:telegram` to enter this token without echoing it.
# On Discloud, add these as application environment variables in the dashboard.
# APP_URL must be the public HTTPS URL serving this GUI (for example, your-app.discloud.app).
# TYPE=bot does not expose a website, so host the GUI publicly and point APP_URL to it.
# Never commit the real token. Rotate it in @BotFather if it has been exposed.
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
APP_URL=https://your-public-app.example

# PORT: The server port (defaults to 3000)
PORT=8080

# NODE_ENV: production or development
NODE_ENV=production
